# ─────────────────────────────────────────────────────────────────────────
# PostGo Environment Template
# Copy to .env and fill in the values:  cp .env.example .env
# Secrets: generate with the commands shown next to each field.
# ─────────────────────────────────────────────────────────────────────────

# ─── Database (docker-compose defaults match these) ──────────────────────
POSTGRES_USER=postgo
POSTGRES_PASSWORD=postgo_secret
POSTGRES_DB=postgo
# Local Docker — the compose file overrides this automatically:
DATABASE_URL=postgresql://postgo:postgo_secret@postgres:5432/postgo?connection_limit=30&pool_timeout=30&connect_timeout=10
# Production (Coolify): point to your managed/DB service and add
# ?connection_limit=30&pool_timeout=30&connect_timeout=10

# ─── Redis ────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── Auth ─────────────────────────────────────────────────────────────────
# openssl rand -base64 48
JWT_SECRET=REPLACE_ME_at_least_32_chars_long

# ─── Token Encryption ─────────────────────────────────────────────────────
# openssl rand -hex 32
ENCRYPTION_KEY=REPLACE_ME_64_hex_chars

# ─── App URLs ─────────────────────────────────────────────────────────────
APP_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3001
# Production: https://your-domain.com

# ─── Cron Protection (publish-scheduled endpoint) ────────────────────────
# openssl rand -hex 24
CRON_SECRET=REPLACE_ME

# ─── Admin Seed Account (prisma/seed.ts only) ─────────────────────────────
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=REPLACE_ME_strong_password

# ─── LinkedIn OAuth (https://www.linkedin.com/developers/apps) ────────────
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3001/api/linkedin/callback
# Production: https://your-domain.com/api/linkedin/callback

# ─── Email — Resend (OTP + password reset) ────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=PostGo <onboarding@resend.dev>

# ─── USDT Payment (TRON chain verification) ───────────────────────────────
TRON_API_KEY=
USDT_WALLET_ADDRESS=
NEXT_PUBLIC_USDT_WALLET_ADDRESS=

# ─── Worker Tuning ────────────────────────────────────────────────────────
WORKER_CONCURRENCY=25
LINKEDIN_RATE_LIMIT_MAX=100
LINKEDIN_RATE_LIMIT_WINDOW_MS=60000
